{
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2018",
    "lib": ["ES2018", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/*"]
}
