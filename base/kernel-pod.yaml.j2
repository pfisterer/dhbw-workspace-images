# Kernel pod for "Python 3 (GPU)", rendered by gateway_provisioners' launch_kubernetes.py: every KERNEL_* variable of the notebook server is available here in lower case. JupyterHub sets KERNEL_HOME_PVC, KERNEL_HOME_SUBPATH and KERNEL_SHARED_SUBPATH (the project's volume, the person's home and the shared folder in it; empty without storage), KERNEL_OWNER_NAME and KERNEL_OWNER_UID (the notebook pod) and KERNEL_HUB_USER_LABEL (the notebook pod's label hub.jupyter.org/username, so that kernels and servers of a person can be counted together) in the profile "CPU + GPU-Kernel". The image is GP_IMAGE_NAME of the notebook pod: this image or a course image derived from it, the same one the notebook runs.
#
# The pod goes through Kueue like a GPU notebook (LocalQueue notebooks), mounts the same home and shared folder as the notebook, belongs to the notebook pod (deleted with it) and may reach the notebook pod (label for the singleuser network policy).
apiVersion: v1
kind: Pod
metadata:
  name: "{{ kernel_pod_name }}"
  namespace: "{{ kernel_namespace }}"
  labels:
    kernel_id: "{{ kernel_id }}"
    app: gateway-provisioners
    component: kernel
    hub.jupyter.org/network-access-singleuser: "true"
    kueue.x-k8s.io/queue-name: notebooks
    dhbw.cloud/kernel-user: "{{ kernel_hub_user_label }}"
  {% if kernel_owner_uid is defined %}
  ownerReferences:
    - apiVersion: v1
      kind: Pod
      name: "{{ kernel_owner_name }}"
      uid: "{{ kernel_owner_uid }}"
  {% endif %}
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  activeDeadlineSeconds: 14400
  securityContext:
    runAsUser: {{ kernel_uid | int }}
    runAsGroup: {{ kernel_gid | int }}
    fsGroup: 100
  tolerations:
    - key: dhbw.cloud/gpu-lab
      operator: Equal
      value: "true"
      effect: NoSchedule
  containers:
    - name: kernel
      image: "{{ kernel_image }}"
      # The launcher of this image (Dockerfile), whatever CMD a derived image sets; the entrypoint of Docker Stacks (tini, start.sh) stays.
      args: [/usr/local/bin/bootstrap-kernel.sh]
      # Required by the admission policy workspace-pods (tasks/jupyterhub.yaml).
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]
      resources:
        requests:
          cpu: "1"
          memory: 2G
          nvidia.com/gpu: "1"
        limits:
          cpu: "3"
          memory: 5G
          nvidia.com/gpu: "1"
      {% if kernel_working_dir is defined %}
      workingDir: "{{ kernel_working_dir }}"
      {% endif %}
      volumeMounts:
        - name: home
          mountPath: /home/jovyan
          {% if kernel_home_pvc | default('') %}
          subPath: "{{ kernel_home_subpath }}"
        - name: home
          mountPath: /home/jovyan/project-shared
          subPath: "{{ kernel_shared_subpath }}"
          {% endif %}
  volumes:
    - name: home
      {% if kernel_home_pvc | default('') %}
      persistentVolumeClaim:
        claimName: "{{ kernel_home_pvc }}"
      {% else %}
      emptyDir: {}
      {% endif %}
